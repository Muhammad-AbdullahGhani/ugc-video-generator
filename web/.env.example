# ==============================================================================
# ReelForge UGC Video Generator — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google OAuth Credentials (Required for Google Sign-In)
# Obtain from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID:
# - Application type: Web application
# - Authorized JavaScript origins: http://localhost:3000 (and your production domain)
# - Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 2. NextAuth.js (Auth.js) Configuration
# - NEXTAUTH_SECRET / AUTH_SECRET: Generate with `openssl rand -base64 32` or any secret string
# - NEXTAUTH_URL: Canonical URL of your deployment (http://localhost:3000 in dev)
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Google Gemini API Key (Required for scraping analysis & UGC script synthesis)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. Reaction GIF Provider (Optional)
# If omitted, built-in curated reaction GIFs are automatically used as fallbacks
# ------------------------------------------------------------------------------
TENOR_API_KEY=your_tenor_api_key_here

# ------------------------------------------------------------------------------
# 5. FFmpeg Binary Path (Optional)
# Defaults automatically to bundled @ffmpeg-installer or system PATH
# ------------------------------------------------------------------------------
# FFMPEG_PATH=/usr/bin/ffmpeg

# ------------------------------------------------------------------------------
# 6. Cloud Storage (Optional)
# If provided, videos are uploaded directly to Vercel Blob storage.
# Otherwise, automatic zero-config cloud storage / range streaming is used.
# ------------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here
