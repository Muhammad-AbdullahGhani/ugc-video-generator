# ==============================================================================
# ReelForge UGC Video Generator — Environment Configuration
#
# Every variable below is read and validated once, in `lib/env.ts`. Nothing else
# reads process.env directly, so this file and the code cannot drift apart.
# The app refuses to start when a required value is missing — that is deliberate.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Session secret — REQUIRED
# Generate with: openssl rand -base64 32
# There is no fallback. A hardcoded default would let anyone holding the source
# forge a session for any user.
# ------------------------------------------------------------------------------
AUTH_SECRET=generate_with_openssl_rand_base64_32

# ------------------------------------------------------------------------------
# 2. Canonical app origin
# Used to derive the OAuth redirect URI and absolute links. Set this to your real
# domain in production (e.g. https://reelforge.example.com).
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Google OAuth (optional — sign-in is unavailable without it unless the
#    demo-guest provider is enabled below)
# Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web application)
# - Authorized JavaScript origin: the value of APP_URL
# - Authorized redirect URI: {APP_URL}/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 4. Demo guest sign-in — DEVELOPMENT ONLY
# This provider authenticates anyone, with no verification, under a random
# guest_*@guest.invalid identity. Leave it unset unless you are demoing locally.
# It is ignored outright when NODE_ENV=production.
# ------------------------------------------------------------------------------
# ENABLE_DEMO_GUEST=true

# ------------------------------------------------------------------------------
# 5. Google Gemini API key — required for blueprint generation
# Free key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=20000
#
# A FREE key is enough for this app. One video = one Gemini call, and free-tier
# daily quotas vary a lot by model (checked Nov 2026): the newest flash is capped
# near 20 requests/day, the previous generation near 250, flash-lite near 500,
# at roughly 10 requests/minute.
#
# The default (gemini-3.6-flash) sits in the ~250/day band, which is well above
# what RENDERS_PER_HOUR permits anyway, and the code falls back to
# gemini-3.5-flash-lite when a model is rate-limited. Do NOT set GEMINI_MODEL to
# the newest flash on a free key — you would run out after ~20 videos.
# Confirm your own numbers under "View your active rate limits" in AI Studio.

# ------------------------------------------------------------------------------
# 6. Reaction GIF provider (optional)
# Without a key, the bundled reaction GIFs in public/assets/gifs are used.
# ------------------------------------------------------------------------------
# GIPHY_API_KEY=your_giphy_api_key_here

# ------------------------------------------------------------------------------
# 7. FFmpeg / ffprobe (optional)
# Both binaries ship via @ffmpeg-installer and @ffprobe-installer. Override only
# when you need a specific build. Without ffprobe, renders are reported as
# UNVERIFIED rather than validated — the app will not claim a check it did not run.
# ------------------------------------------------------------------------------
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ------------------------------------------------------------------------------
# 8. Video storage — REQUIRED IN PRODUCTION
# Rendered videos go to Vercel Blob. There is no third-party fallback: a public
# anonymous host is not an acceptable home for a user's unreleased marketing
# asset. In development, renders are served locally behind signed URLs.
# ------------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# ------------------------------------------------------------------------------
# 9. Abuse and cost controls (optional — sensible defaults shown)
# Rendering is authenticated and metered. These bound what one account can spend
# of your Gemini quota and your CPU.
# ------------------------------------------------------------------------------
# RENDERS_PER_HOUR=10
# CHAT_PER_MINUTE=20
# MAX_MESSAGE_CHARS=2000
# MAX_HISTORY_TURNS=10
# MAX_FETCH_BYTES=2097152

# ------------------------------------------------------------------------------
# 10. Render engine limits (optional)
# ------------------------------------------------------------------------------
# RENDER_MAX_CONCURRENT=2
# RENDER_TIMEOUT_MS=45000
# RENDER_RETENTION_MS=21600000

# ------------------------------------------------------------------------------
# 11. Local data directory (optional)
# Where the JSON video-history store lives. Defaults to web/.data locally and the
# system temp dir on serverless — where it does NOT survive a cold start. Point
# this at a persistent volume, or move the store to a database, before promising
# users a durable library.
# ------------------------------------------------------------------------------
# DATA_DIR=/var/lib/reelforge
